# Supabase credentials for import scripts
# Copy this file to .env and fill in your values
#
# Get these from: Supabase Dashboard > Project Settings > API
# - URL: Use the "Project URL" (NOT the PostgreSQL connection string)
# - Key: Use the "service_role" key (NOT the anon key)

# Development environment (bravo-dev)
SUPABASE_DEV_URL=https://your-dev-project-ref.supabase.co
SUPABASE_DEV_SERVICE_KEY=eyJ...your-service-role-key...

# Production environment (bravo-prod)
SUPABASE_PROD_URL=https://your-prod-project-ref.supabase.co
SUPABASE_PROD_SERVICE_KEY=eyJ...your-service-role-key...
